---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import PageHead from '../components/PageHead.astro';
import { gallery, pic } from '../lib/content';
---
<Layout title="Gallery" current="gallery">
  <PageHead title="Gallery" jp="写真"><span class="soft">Images collected along the way.</span></PageHead>
  <div class="g sec">
    <div class="cards three">
      {gallery.map((g, i) => (
        <figure class:list={['card', { tall: i % 3 === 1 }]} style="margin:0">
          <div class="ph fill"><Pic picture={pic(g)} alt={g.caption} /></div>
          <figcaption class="cap"><span class="lab soft">{g.caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</Layout>
