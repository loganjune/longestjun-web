---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import PhotoGallery from '../../components/react/PhotoGallery';
import PageHead from '../../components/PageHead.astro';
import { gallery, pic } from '../../lib/content';
import { getAlbums, albumCover } from '../../lib/albums';
import { url } from '../../lib/url';

const albums = await getAlbums();
---
<Layout title="Gallery" current="gallery">
  <PageHead title="Gallery" jp="写真"><span class="soft">Images collected along the way.</span></PageHead>
  {gallery.length > 0 && (
    <div class="g sec">
      <PhotoGallery client:visible label="Gallery" photos={gallery.map((g) => ({ picture: pic(g), caption: g.caption }))} />
    </div>
  )}
  {albums.length > 0 && (
    <div class="g sec albums">
      <div class="split" style="margin-bottom:28px"><span class="lab">Albums</span><span></span></div>
      <div class="cards">
        {albums.map((a) => (
          <a class="card album" href={url(`gallery/${a.id}`)}>
            <div class="ph fill"><Pic picture={albumCover(a.data)} alt="" /><span class="album-name disp" aria-hidden="true">{a.data.title}</span></div>
            <div class="cap">
              <div><h3 class="album-title">{a.data.title}</h3>{a.data.location && <p>{a.data.location}</p>}</div>
              <span class="lab soft">{a.data.photos.length} {a.data.photos.length === 1 ? 'photo' : 'photos'} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</Layout>
