---
// One gallery album: its details, the optional travel story, then its photos.
import Layout from '../../layouts/Layout.astro';
import PhotoGallery from '../../components/react/PhotoGallery';
import PageHead from '../../components/PageHead.astro';
import { render } from 'astro:content';
import { getAlbums } from '../../lib/albums';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { album: album.id }, props: { album } }));
}

const { album } = Astro.props;
const { title, location, description, photos, draft } = album.data;
const { Content } = await render(album);
const hasStory = Boolean(album.body?.trim());
---
<Layout title={title} description={description || location} current="gallery">
  <PageHead title={title} jp="写真">
    <span class="lab soft links">{location && <span>{location}</span>}<span>{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</span>{draft && <span>Draft</span>}</span>
  </PageHead>
  <div class="g sec split">
    <a class="lab soft" href={url('gallery')} style="text-decoration:none;align-self:start">← Gallery</a>
    <div>
      {description && <p class="statement" style="margin-bottom:32px">{description}</p>}
      {hasStory && <article class="note-body"><Content /></article>}
    </div>
  </div>
  {photos.length > 0 && (
    <div class="g sec">
      <PhotoGallery client:visible label={title} photos={photos.map((p) => ({ picture: p.photo, caption: p.caption }))} />
    </div>
  )}
</Layout>
